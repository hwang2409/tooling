<mujoco model="hfield_sphere_ramp">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="Euler"
          solver="PGS" cone="pyramidal" iterations="20"/>
  <asset>
    <hfield name="ramp" nrow="3" ncol="3" size="2 2 0.8 0.2"
            elevation="0 0.15 0.3 0.2 0.35 0.5 0.4 0.6 0.8"/>
  </asset>
  <worldbody>
    <geom name="terrain" type="hfield" hfield="ramp" friction="0.8"/>
    <body name="ball" pos="-1.1 -1.2 1.4">
      <freejoint name="ball_root"/>
      <inertial pos="0 0 0" mass="0.5" diaginertia="0.002 0.002 0.002"/>
      <geom name="ball_sphere" type="sphere" size="0.16" friction="0.8"/>
    </body>
  </worldbody>
</mujoco>
