<!-- Differential scenario: a motor-driven slide mass on a spatial tendon
  wrapping an infinite cylinder. The cylinder axis is vertical, so the
  changing slide height exercises MuJoCo's axial lift term. -->
<mujoco model="tendon_cylinder_lift">
  <compiler angle="radian"/>
  <option timestep="0.005" gravity="0 0 -9.81"
          integrator="Euler" solver="PGS" cone="pyramidal" iterations="20"/>
  <worldbody>
    <body name="rig" pos="0 0 0">
      <inertial pos="0 0 0" mass="1.0" diaginertia="1.0 1.0 1.0"/>
      <geom name="wrap_cylinder" type="cylinder" size="0.3 1.0" pos="0.5 0 -0.4"/>
      <site name="anchor" pos="0 0 0"/>
      <site name="side" pos="0.5 0.6 -0.4"/>
      <body name="mass" pos="1.0 0 -0.9">
        <inertial pos="0 0 0" mass="1.0" diaginertia="1e-3 1e-3 1e-3"/>
        <joint name="lift" type="slide" axis="0 0 -1" pos="0 0 0" damping="4.0"/>
        <site name="attach" pos="0 0 0"/>
      </body>
    </body>
  </worldbody>
  <tendon>
    <spatial name="cable" springlength="1.5" stiffness="120" damping="8">
      <site site="anchor"/>
      <geom geom="wrap_cylinder" sidesite="side"/>
      <site site="attach"/>
    </spatial>
  </tendon>
  <actuator>
    <motor name="lift_motor" tendon="cable" gear="1" forcerange="-8 8"/>
  </actuator>
</mujoco>
