<mujoco model="hfield_friction_slope_stop">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 0" integrator="Euler"
          solver="PGS" cone="pyramidal" iterations="20"/>
  <asset>
    <hfield name="slope" nrow="2" ncol="2" size="1.5 1.5 0.2 0.3"
            elevation="0 0.02 0 0.02"/>
  </asset>
  <worldbody>
    <geom name="slope_geom" type="hfield" hfield="slope" friction="1.5"/>
    <body name="box" pos="-0.5 0 0.35">
      <freejoint name="box_root"/>
      <inertial pos="0 0 0" mass="1.0" diaginertia="0.12 0.10 0.08"/>
      <geom name="box_geom" type="box" size="0.2 0.2 0.15" friction="1.5"/>
    </body>
  </worldbody>
</mujoco>
