<mujoco model="hfield_bowl_settle">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="Euler"
          solver="PGS" cone="pyramidal" iterations="20"/>
  <asset>
    <hfield name="bowl" nrow="3" ncol="3" size="1.5 1.5 0.4 0.3"
            elevation="0.8 0.5 0.8 0.5 0 0.5 0.8 0.5 0.8"/>
  </asset>
  <worldbody>
    <geom name="bowl_geom" type="hfield" hfield="bowl" friction="0.9"/>
    <body name="ball" pos="0 0 1.0">
      <freejoint name="ball_root"/>
      <inertial pos="0 0 0" mass="0.5" diaginertia="0.002 0.002 0.002"/>
      <geom name="ball_sphere" type="sphere" size="0.16" friction="0.9"/>
    </body>
  </worldbody>
</mujoco>
