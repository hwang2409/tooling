<!-- Differential scenario: 2-hinge chain on a fixed anchor, no contacts.
  Chaotic dynamics — we compare over a SHORT horizon (see
  scenarios.json). Beyond ~1 s the trajectories diverge macroscopically
  and per-sample q-comparison is meaningless; the scorecard uses
  short-horizon q divergence AND long-horizon energy conservation.
-->
<mujoco model="double_pendulum">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"
          integrator="RK4" solver="PGS" cone="pyramidal" iterations="20"/>
  <worldbody>
    <body name="pivot" pos="0 0 1.5">
      <inertial pos="0 0 0" mass="1.0" diaginertia="1.0 1.0 1.0"/>

      <body name="upper" pos="0 0 -0.45">
        <joint name="upper_hinge" type="hinge" axis="1 0 0" pos="0 0 0.45"/>
        <inertial pos="0 0 0" mass="1.3" diaginertia="0.08775 0.08775 1e-6"/>

        <body name="lower" pos="0 0 -0.75">
          <joint name="lower_hinge" type="hinge" axis="1 0 0" pos="0 0 0.3"/>
          <inertial pos="0 0 0" mass="0.7" diaginertia="0.021 0.021 1e-6"/>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
