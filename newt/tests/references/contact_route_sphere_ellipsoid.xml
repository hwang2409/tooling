    <body name="sphere_deep" pos="0.52 0 0">
      <freejoint/>
      <inertial pos="0 0 0" mass="1" diaginertia="1 1 1"/>
      <geom name="sphere_deep" type="sphere" size="0.2"/>
    </body>
    <body name="ellipsoid_deep">
      <freejoint/>
      <inertial pos="0 0 0" mass="1" diaginertia="1 1 1"/>
      <geom name="ellipsoid_deep" type="ellipsoid" size="0.5 0.3 0.2"/>
    </body>
    <body name="sphere_off_axis" pos="0.45 0.2 0.1">
      <freejoint/>
      <inertial pos="0 0 0" mass="1" diaginertia="1 1 1"/>
      <geom name="sphere_off_axis" type="sphere" size="0.2"/>
    </body>
    <body name="ellipsoid_off_axis" euler="0.2 0.3 0.4">
      <freejoint/>
      <inertial pos="0 0 0" mass="1" diaginertia="1 1 1"/>
      <geom name="ellipsoid_off_axis" type="ellipsoid" size="0.5 0.3 0.2"/>
    </body>
  </worldbody>
</mujoco>
