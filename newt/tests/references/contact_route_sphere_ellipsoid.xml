  <worldbody>
    <body name="sphere_no_contact" pos="1 0 0">
      <freejoint/>
      <inertial pos="0 0 0" mass="1" diaginertia="1 1 1"/>
      <geom name="sphere_no_contact" type="sphere" size="0.2"/>
    </body>
    <body name="ellipsoid_no_contact">
      <freejoint/>
      <inertial pos="0 0 0" mass="1" diaginertia="1 1 1"/>
      <geom name="ellipsoid_no_contact" type="ellipsoid" size="0.5 0.3 0.2"/>
