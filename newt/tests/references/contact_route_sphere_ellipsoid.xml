    <body name="sphere_shallow" pos="0.695 0 0">
      <freejoint/>
      <inertial pos="0 0 0" mass="1" diaginertia="1 1 1"/>
      <geom name="sphere_shallow" type="sphere" size="0.2"/>
    </body>
    <body name="ellipsoid_shallow">
      <freejoint/>
      <inertial pos="0 0 0" mass="1" diaginertia="1 1 1"/>
      <geom name="ellipsoid_shallow" type="ellipsoid" size="0.5 0.3 0.2"/>
