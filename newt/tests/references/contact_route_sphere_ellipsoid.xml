<mujoco model="contact_route_sphere_ellipsoid">
  <option gravity="0 0 0"/>
  <contact>
    <pair geom1="sphere_no_contact" geom2="ellipsoid_no_contact"/>
    <pair geom1="sphere_shallow" geom2="ellipsoid_shallow"/>
    <pair geom1="sphere_deep" geom2="ellipsoid_deep"/>
    <pair geom1="sphere_off_axis" geom2="ellipsoid_off_axis"/>
