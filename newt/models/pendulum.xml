<!-- MJCF mirror of models/pendulum.json.

  Byte-identical trajectory anchor against pendulum.json — see
  `tests/mjcf_anchor.rs`. Body pos values are chosen so that the
  MJCF conversion (joint_offset_in_parent = body.pos + joint.pos,
  joint_offset_in_child = joint.pos) reproduces the JSON model's
  joint anchor positions in the parent's body frame:

    * pivot (fixed root at world 0,0,1.5)
    * upper: body.pos = (0,0,-0.45), joint.pos = (0,0,0.45)
        → joint anchor in pivot frame (0,0,0), joint anchor in upper frame (0,0,0.45)
    * lower: body.pos = (0,0,-0.75), joint.pos = (0,0,0.3)
        → joint anchor in upper frame (0,0,-0.45), joint anchor in lower frame (0,0,0.3)
-->
<mujoco model="pendulum">
  <compiler angle="radian"/>
  <option timestep="0.005" gravity="0 0 -9.81"/>

  <worldbody>
    <body name="pivot" pos="0 0 1.5">
      <inertial pos="0 0 0" mass="1.0" diaginertia="1.0 1.0 1.0"/>

      <body name="upper" pos="0 0 -0.45">
        <joint name="upper_hinge" type="hinge" axis="1 0 0" pos="0 0 0.45"/>
        <inertial pos="0 0 0" mass="1.3" diaginertia="0.08775 0.08775 1e-6"/>

        <body name="lower" pos="0 0 -0.75">
          <joint name="lower_hinge" type="hinge" axis="1 0 0" pos="0 0 0.3"/>
          <inertial pos="0 0 0" mass="0.7" diaginertia="0.021 0.021 1e-6"/>
          <site name="tip" pos="0 0 -0.3"/>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
