<!-- biped-simple.xml — v1 finale fixture.

  Simplified version of the reference biped model at
  ~/me/fun/biped/biped/models/biped.xml (10 hinge joints, freejoint
  torso, capsule limbs, box feet, position actuators). Simplifications
  applied to stay within newt's v1 MJCF subset (see docs/mjcf.md):

    * torso collapsed from three geoms (chest + pelvis + head) into
      one box at the body origin, so the auto-inertia helper handles
      it without a parallel-axis walk
    * body origins re-anchored to their geom centers so every leg
      body carries exactly one geom at pos=[0 0 0] with identity
      orientation (autoinertia constraint)
    * <asset> / <material> / rendering-only bits stripped

  Actuator gains + joint targets track the source biped's `stand`
  scenario (biped/mujoco_biped.py, SCENARIO_DEFINITIONS["stand"]):
  kp in [45, 80], forcerange in ±[45, 80], damping in [2, 8] (roll
  joints get the higher damping), knee_target=0.16 rad,
  ankle_target=-0.05 rad. Feet sit flush with the ground under COM.

  Two biped smoke tests in tests/mjcf_load.rs:
    * `biped_simple_pure_pd_smoke` — pure joint PD, NO external
      assist. Asserts the sim stays finite and the biped exhibits
      its characteristic pure-PD fall between steps 300 and 600 to
      <= 20% of initial height (matching source biped behavior —
      no source scenario stands with pure PD either).
    * `biped_simple_stands_with_source_balance_assist` — applies
      the source `_apply_balance_controller` wrench (all 6
      components, world-frame) each step, mirroring what the
      source `stand` scenario runs at assist_scale=1.0. Asserts
      root height > 80% of initial and torso tilt < 15° for the
      full 2000 steps.

  Full standing note + parameter-by-parameter diagnosis lives in
  docs/mjcf.md.
-->
<mujoco model="biped-simple">
  <compiler angle="radian"/>
  <option timestep="0.005" gravity="0 0 -9.81" cone="elliptic" solver="PGS"/>

  <default>
    <joint damping="2.0" armature="0.02"/>
    <geom friction="1.2 0.08 0.02" solref="0.02 1" solimp="0.9 0.95 0.001"/>
  </default>

  <!-- torso pos so foot-box bottom = 0 (feet flush with ground).
       Total leg drop (straight legs): torso half-z 0.35 + hip_roll_link 0
       + thigh half 0.21 + thigh->shin 0.21 + shin half 0.21 + shin->ankle 0.21
       + foot half-z 0.035 = 1.235. Foot center at torso_z - 1.20 = 0.035
       so foot bottom = 0. -->
  <worldbody>
    <geom name="ground" type="plane" friction="1.2 0.08 0.02"/>

    <body name="torso" pos="0 0 1.235">
      <freejoint name="torso_root"/>
      <geom name="torso_geom" type="box" size="0.14 0.13 0.35" mass="9.7"/>

      <!-- ============ left leg ============ -->
      <body name="left_hip_roll_link" pos="0 0.18 -0.35">
        <inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
        <joint name="left_hip_roll" type="hinge" axis="1 0 0"
               range="-0.7 0.7" damping="8.0" armature="0.05"/>

        <body name="left_thigh" pos="0 0 -0.21">
          <joint name="left_hip" type="hinge" axis="0 1 0" pos="0 0 0.21"
                 range="-1.0 1.0"/>
          <geom name="left_thigh_geom" type="capsule" size="0.045 0.21" mass="2.2"/>

          <body name="left_shin" pos="0 0 -0.42">
            <joint name="left_knee" type="hinge" axis="0 1 0" pos="0 0 0.21"
                   range="-0.1 1.7"/>
            <geom name="left_shin_geom" type="capsule" size="0.038 0.21" mass="1.6"/>

            <body name="left_ankle_roll_link" pos="0 0 -0.21">
              <inertial pos="0 0 0" mass="0.03" diaginertia="0.0005 0.0005 0.0005"/>
              <joint name="left_ankle_roll" type="hinge" axis="1 0 0"
                     range="-0.5 0.5" damping="5.0" armature="0.04"/>

              <body name="left_foot" pos="0.075 0 -0.035">
                <joint name="left_ankle" type="hinge" axis="0 1 0"
                       pos="-0.075 0 0.035" range="-0.8 0.8"/>
                <geom name="left_foot_geom" type="box"
                      size="0.17 0.07 0.035" mass="0.8"/>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ============ right leg ============ -->
      <body name="right_hip_roll_link" pos="0 -0.18 -0.35">
        <inertial pos="0 0 0" mass="0.05" diaginertia="0.001 0.001 0.001"/>
        <joint name="right_hip_roll" type="hinge" axis="1 0 0"
               range="-0.7 0.7" damping="8.0" armature="0.05"/>

        <body name="right_thigh" pos="0 0 -0.21">
          <joint name="right_hip" type="hinge" axis="0 1 0" pos="0 0 0.21"
                 range="-1.0 1.0"/>
          <geom name="right_thigh_geom" type="capsule" size="0.045 0.21" mass="2.2"/>

          <body name="right_shin" pos="0 0 -0.42">
            <joint name="right_knee" type="hinge" axis="0 1 0" pos="0 0 0.21"
                   range="-0.1 1.7"/>
            <geom name="right_shin_geom" type="capsule" size="0.038 0.21" mass="1.6"/>

            <body name="right_ankle_roll_link" pos="0 0 -0.21">
              <inertial pos="0 0 0" mass="0.03" diaginertia="0.0005 0.0005 0.0005"/>
              <joint name="right_ankle_roll" type="hinge" axis="1 0 0"
                     range="-0.5 0.5" damping="5.0" armature="0.04"/>

              <body name="right_foot" pos="0.075 0 -0.035">
                <joint name="right_ankle" type="hinge" axis="0 1 0"
                       pos="-0.075 0 0.035" range="-0.8 0.8"/>
                <geom name="right_foot_geom" type="box"
                      size="0.17 0.07 0.035" mass="0.8"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Actuator gains + targets mirror the source biped's stand
       scenario (biped/mujoco_biped.py SCENARIO_DEFINITIONS["stand"]:
       knee_target=0.16, ankle_target=-0.05). kp / forcerange live
       inside the source's 45–80 window. -->
  <actuator>
    <position name="left_hip_roll_motor"   joint="left_hip_roll"
              kp="70" kv="6" forcerange="-70 70"/>
    <position name="left_hip_motor"        joint="left_hip"
              kp="70" kv="6" forcerange="-70 70"/>
    <position name="left_knee_motor"       joint="left_knee"
              kp="80" kv="6" forcerange="-80 80"/>
    <position name="left_ankle_roll_motor" joint="left_ankle_roll"
              kp="45" kv="5" forcerange="-45 45"/>
    <position name="left_ankle_motor"      joint="left_ankle"
              kp="45" kv="5" forcerange="-45 45"/>

    <position name="right_hip_roll_motor"   joint="right_hip_roll"
              kp="70" kv="6" forcerange="-70 70"/>
    <position name="right_hip_motor"        joint="right_hip"
              kp="70" kv="6" forcerange="-70 70"/>
    <position name="right_knee_motor"       joint="right_knee"
              kp="80" kv="6" forcerange="-80 80"/>
    <position name="right_ankle_roll_motor" joint="right_ankle_roll"
              kp="45" kv="5" forcerange="-45 45"/>
    <position name="right_ankle_motor"      joint="right_ankle"
              kp="45" kv="5" forcerange="-45 45"/>
  </actuator>
</mujoco>
